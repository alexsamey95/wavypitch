# Copy these into your Streamlit secrets.
# - Streamlit Cloud: App -> Settings -> Secrets
# - Locally: save as .streamlit/secrets.toml (NEVER commit the real file)

SPOTIFY_CLIENT_ID     = "from developer.spotify.com/dashboard (free)"
SPOTIFY_CLIENT_SECRET = "..."
APIFY_API_TOKEN = "your-apify-token"          # only for the Instagram bio step (and optional Apify actor)
GEMINI_API_KEY  = "your-gemini-key"

# GitHub auto-save (data survives Streamlit Cloud reboots)
GITHUB_TOKEN = "github_pat_..."          # fine-grained token, THIS repo only, Contents: Read & write
GITHUB_REPO  = "yourname/wavypitch"      # owner/repo of THIS app
# GITHUB_DATA_BRANCH = "app-data"        # optional, default shown
